## orm Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Schema models shared by every ORM operation. Field kinds reuse the
## `db::ParamKind` value space (`1`=INTEGER, `2`=REAL, `3`=TEXT, `5`=BLOB);
## `4` (Null) is a value kind only and is rejected for columns. The
## `KIND_*` constants below mirror those values so callers need no `db`
## import just to define a model.

import "db" as db

## Column kind: INTEGER storage.
pub const KIND_INT = 1

## Column kind: REAL storage (values travel as round-trip text).
pub const KIND_FLOAT = 2

## Column kind: TEXT storage.
pub const KIND_TEXT = 3

## Column kind: BLOB storage (byte arrays).
pub const KIND_BLOB = 5

## A single mapped column.
##
## ### Fields
## - `name`: Column name string.
## - `kind`: One of `KIND_INT`, `KIND_FLOAT`, `KIND_TEXT`, `KIND_BLOB`.
## - `pk`: `1` for `INTEGER PRIMARY KEY` (requires kind `KIND_INT`), else `0`.
pub struct FieldDef
    name: string
    kind: int
    pk: int
end

## A mapped table: ordered columns plus helpers.
##
## ### Fields
## - `table`: Table name string.
## - `fields`: Array of `FieldDef` in column order.
pub struct ModelDef
    table: string
    fields: array
end

## Creates a column definition.
##
## ### Parameters
## - `name`: Column name string.
## - `kind`: Column kind int (`KIND_INT`, `KIND_FLOAT`, `KIND_TEXT`, `KIND_BLOB`).
## - `pk`: `1` for primary key (requires kind `KIND_INT`). Defaults to `0`.
##
## ### Returns
## A validated `FieldDef` (throws on unknown kinds or bad pk).
pub function field(name: string, kind: int, pk: int = 0) -> FieldDef
    if kind != 1 and kind != 2 and kind != 3 and kind != 5
        throw db::db_error(2, "orm: unknown field kind for column '" + name + "'")
    end
    if pk == true and kind != 1
        throw db::db_error(2, "orm: primary key column '" + name + "' must be INTEGER")
    end
    return FieldDef { name: name, kind: kind, pk: pk }
end

## Creates a table model from ordered column definitions.
##
## ### Parameters
## - `table`: Table name string.
## - `fields`: Array of `FieldDef` (at least one).
##
## ### Returns
## A validated `ModelDef` (throws on empty field lists).
pub function define_model(table: string, fields: array) -> ModelDef
    if len(fields) == 0
        throw db::db_error(2, "orm: model '" + table + "' needs at least one field")
    end
    return ModelDef { table: table, fields: fields }
end

## Finds a field by name, or null when the model has no such column.
##
## ### Parameters
## - `model`: Target `ModelDef`.
## - `name`: Column name string.
##
## ### Returns
## The `FieldDef`, or null.
pub function find_field(model: ModelDef, name: string)
    for f in model.fields
        if field_name(f) == name
            return f
        end
    end
    return null
end

## Finds the primary-key field, or null when the model has none.
##
## ### Parameters
## - `model`: Target `ModelDef`.
##
## ### Returns
## The pk `FieldDef`, or null.
pub function pk_field(model: ModelDef)
    for f in model.fields
        if f.pk == true
            return f
        end
    end
    return null
end

## Reads a field's column name through a statically-typed boundary.
##
## Untyped `.name` reads are ambiguous across packages (`Driver`,
## `FieldDef`); this helper pins the `FieldDef` layout.
##
## ### Parameters
## - `f`: Target `FieldDef`.
##
## ### Returns
## The column name string.
pub function field_name(f: FieldDef) -> string
    return f.name
end

## Reads a field's column kind through a statically-typed boundary.
##
## Untyped `.kind` reads are ambiguous across packages (`DbParam`,
## `Param`, `FieldDef` disagree on the index); this helper pins the
## `FieldDef` layout.
##
## ### Parameters
## - `f`: Target `FieldDef`.
##
## ### Returns
## The column kind integer.
pub function field_kind(f: FieldDef) -> int
    return f.kind
end
