## orm Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Descriptor-driven object-relational mapping over `db`: models declare
## columns once (`define_model`), and every operation builds injection-safe
## parameterized SQL from the descriptor. Values travel strictly typed —
## conversions belong at the caller's proven site, never in here — so this
## package runs zero `int()`/`float()` conversions on dynamics. Float
## columns take round-trip text (e.g. straight from a previous query row).

import "db" as db
import "./types.alya"

# ───────────────────────────────────────────────────────────────
# Internal builders (no `pub`: callers use the facade below)
# ───────────────────────────────────────────────────────────────

function join_comma(parts: array) -> string
    let out = ""
    let i = 0
    while i < len(parts)
        if i > 0
            out += ", "
        end
        out += parts[i]
        i += 1
    end
    return out
end

function column_sql(f: FieldDef) -> string
    let kind = f.colkind
    when kind
        is 1 then
            if f.pk == true
                return f.colname + " INTEGER PRIMARY KEY"
            end
            return f.colname + " INTEGER"
        is 2 then return f.colname + " REAL"
        is 3 then return f.colname + " TEXT"
        is 5 then return f.colname + " BLOB"
        else throw db::db_error(2, f"orm: unknown kind for column '{f.colname}'")
    end
end

# Converts one value to a `db` Param using the DECLARED column kind only.
# Null and integer `0` are distinct as literals and inline map reads
# (tagged KIND_NULL, alya-lang/alya#168), but the tag does NOT survive
# every transport: a map-read `0` passed as a function argument checks
# `is null` (and a let-bound map-read/function-return null checks
# non-null). This function receives its value as an argument, so callers
# must avoid `0` as a significant value — use auto-rowid or start ids
# at 1. `is string` stays heap-range. Float `0.0` travels as round-trip
# text, like every float.
function param_for(field: FieldDef, val)
    let kind = field.colkind
    let col = field.colname
    if val is null
        return db::param_null()
    end
    if val is string
        if kind == 2 or kind == 3
            let s: string = val
            return db::param_text(s)
        end
        throw db::db_error(2, f"orm: text value for non-text column '{col}'")
    end
    if kind == 5
        return db::param_blob(val)
    end
    if kind == 1 or kind == 2
        return db::param_int(val)
    end
    throw db::db_error(2, f"orm: column '{col}' needs int, text, blob, or null")
end

function model_param(model: ModelDef, col: string, val)
    # Null guard runs inline on the call: null returned from a
    # dynamically-typed function loses its tag when let-bound (compiler
    # follow-up to alya-lang/alya#168), so the value is re-fetched below.
    if find_field(model, col) is null
        throw db::db_error(2, f"orm: unknown column '{col}'")
    end
    let f = find_field(model, col)
    return param_for(f, val)
end

# Internal pair type: where_parts returns one struct instead of a
# heterogeneous array literal (mixed literals demote element types).
struct WhereClause
    sql: string
    params: array
end

# Builds " WHERE k = ? AND ..." plus the param array. Null `cond` means
# no filter. Unknown keys throw (injection-proof by construction).
function where_parts(model: ModelDef, cond) -> WhereClause
    let sql = ""
    let params = []
    if cond is null
        return WhereClause { sql: sql, params: params }
    end
    let ks = keys(cond)
    let first = true
    for k in ks
        # Inline null guard (see model_param): let-binding a dynamic
        # null return demotes it to int 0 on current compilers.
        if find_field(model, k) is null
            throw db::db_error(2, f"orm: unknown column '{k}'")
        end
        let f = find_field(model, k)
        if first
            sql += " WHERE "
            first = false
        else
            sql += " AND "
        end
        sql += k + " = ?"
        params.push(param_for(f, cond[k]))
    end
    return WhereClause { sql: sql, params: params }
end

function order_clause(model: ModelDef, order: string, direction: string) -> string
    if order == ""
        return ""
    end
    if find_field(model, order) is null
        throw db::db_error(2, f"orm: unknown order column '{order}'")
    end
    if direction != "ASC" and direction != "DESC"
        throw db::db_error(2, f"orm: order direction must be ASC or DESC")
    end
    return " ORDER BY " + order + " " + direction
end

# ───────────────────────────────────────────────────────────────
# Schema
# ───────────────────────────────────────────────────────────────

## Renders the CREATE TABLE statement for a model (no execution).
##
## ### Parameters
## - `model`: Target `ModelDef`.
##
## ### Returns
## The DDL string (handy for logging and migrations).
pub function create_table_sql(model: ModelDef) -> string
    let parts = []
    for f in model.fields
        parts.push(column_sql(f))
    end
    return "CREATE TABLE " + model.table + " (" + join_comma(parts) + ");"
end

## Creates the model's table.
##
## ### Parameters
## - `conn`: Target `db` connection (untyped: any driver handle).
## - `model`: Target `ModelDef`.
##
## ### Returns
## Affected row count integer.
pub function create_table(conn, model: ModelDef) -> int
    return db::execute(conn, create_table_sql(model), [])
end

## Drops the model's table.
##
## ### Parameters
## - `conn`: Target `db` connection.
## - `model`: Target `ModelDef`.
##
## ### Returns
## Affected row count integer.
pub function drop_table(conn, model: ModelDef) -> int
    return db::execute(conn, "DROP TABLE " + model.table + ";", [])
end

# ───────────────────────────────────────────────────────────────
# Writes
# ───────────────────────────────────────────────────────────────

## Inserts one row; every model column needs a value (null allowed).
##
## Values must arrive in column type: ints for INTEGER, strings for TEXT,
## round-trip text for REAL, byte arrays for BLOB, null anywhere. Missing
## keys and mistyped values throw a `DbError` naming the column.
##
## ### Parameters
## - `conn`: Target `db` connection.
## - `model`: Target `ModelDef`.
## - `values`: Map of column name to value.
##
## ### Returns
## Affected row count integer (1 on success).
##
## ### Examples
## ```alya
## insert(conn, users, { "name": "Alice", "score": "95.5" })
## ```
pub function insert(conn, model, values) -> int
    let cols = []
    let holders = []
    let params = []
    for f in model.fields
        if field_name(f) in values
            cols.push(field_name(f))
            holders.push("?")
            params.push(param_for(f, values[field_name(f)]))
        else
            throw db::db_error(2, f"orm: missing value for column '{field_name(f)}'")
        end
    end
    let sql = "INSERT INTO " + model.table + " (" + join_comma(cols) + ") VALUES (" + join_comma(holders) + ");"
    return db::execute(conn, sql, params)
end

## Updates rows matching `cond` (null `cond` updates every row).
##
## ### Parameters
## - `conn`: Target `db` connection.
## - `model`: Target `ModelDef`.
## - `values`: Map of column name to new value (at least one).
## - `cond`: Filter map, or null for all rows.
##
## ### Returns
## Affected row count integer.
pub function update(conn, model: ModelDef, values, cond = null) -> int
    let sets = []
    let params = []
    let vks = keys(values)
    for k in vks
        # Inline null guard (see model_param): let-binding a dynamic
        # null return demotes it to int 0 on current compilers.
        if find_field(model, k) is null
            throw db::db_error(2, f"orm: unknown column '{k}'")
        end
        let f = find_field(model, k)
        sets.push(k + " = ?")
        params.push(param_for(f, values[k]))
    end
    if len(sets) == 0
        throw db::db_error(2, "orm: update needs at least one column")
    end
    let parts = where_parts(model, cond)
    let all_params = []
    for p in params
        all_params.push(p)
    end
    for p in parts.params
        all_params.push(p)
    end
    let sql = "UPDATE " + model.table + " SET " + join_comma(sets) + parts.sql + ";"
    return db::execute(conn, sql, all_params)
end

## Deletes rows matching `cond` (null refuses: use `drop_table` to clear).
##
## ### Parameters
## - `conn`: Target `db` connection.
## - `model`: Target `ModelDef`.
## - `cond`: Filter map (must be non-empty).
##
## ### Returns
## Affected row count integer.
pub function delete_where(conn, model: ModelDef, cond) -> int
    if cond is null
        throw db::db_error(2, "orm: refusing unconditional delete (use drop_table to clear)")
    end
    let parts = where_parts(model, cond)
    if parts.sql == ""
        throw db::db_error(2, "orm: refusing unconditional delete (use drop_table to clear)")
    end
    return db::execute(conn, "DELETE FROM " + model.table + parts.sql + ";", parts.params)
end

## Deletes one row by primary key.
##
## ### Parameters
## - `conn`: Target `db` connection.
## - `model`: Target `ModelDef` (must declare a pk field).
## - `id`: Primary key value.
##
## ### Returns
## Affected row count integer.
pub function delete_by_id(conn, model: ModelDef, id) -> int
    # Inline null guard (see model_param): let-binding a dynamic
    # null return demotes it to int 0 on current compilers.
    if pk_field(model) is null
        throw db::db_error(2, f"orm: model '{model.table}' has no primary key")
    end
    let pk = pk_field(model)
    let cond = map()
    cond[field_name(pk)] = id
    return delete_where(conn, model, cond)
end

# ───────────────────────────────────────────────────────────────
# Reads
# ───────────────────────────────────────────────────────────────

## Returns all rows, optionally ordered and limited.
##
## Rows are column-name maps (see `db::query`); use `db` row helpers or
## explicit reads to fill your structs.
##
## ### Parameters
## - `conn`: Target `db` connection.
## - `model`: Target `ModelDef`.
## - `order`: Order column name, or `""` for none.
## - `direction`: `"ASC"` or `"DESC"` (validated).
## - `limit`: Row cap integer (`-1` for none).
##
## ### Returns
## Array of row maps (possibly empty).
pub function find_all(conn, model: ModelDef, order: string = "", direction: string = "ASC", limit: int = -1) -> array
    let sql = "SELECT * FROM " + model.table + order_clause(model, order, direction)
    if limit != -1
        if limit < 0
            throw db::db_error(2, "orm: limit must be -1 or non-negative")
        end
        sql += " LIMIT " + str(limit)
    end
    return db::query(conn, sql + ";", [])
end

## Returns rows matching `cond` (null `cond` matches all rows).
##
## ### Parameters
## - `conn`: Target `db` connection.
## - `model`: Target `ModelDef`.
## - `cond`: Filter map of column name to value, or null.
## - `order`: Order column name, or `""` for none.
## - `direction`: `"ASC"` or `"DESC"` (validated).
## - `limit`: Row cap integer (`-1` for none).
##
## ### Returns
## Array of row maps (possibly empty).
pub function where(conn, model: ModelDef, cond = null, order: string = "", direction: string = "ASC", limit: int = -1) -> array
    let parts = where_parts(model, cond)
    let sql = "SELECT * FROM " + model.table + parts.sql + order_clause(model, order, direction)
    if limit != -1
        if limit < 0
            throw db::db_error(2, "orm: limit must be -1 or non-negative")
        end
        sql += " LIMIT " + str(limit)
    end
    return db::query(conn, sql + ";", parts.params)
end

## Returns one row by primary key, or null when missing.
##
## ### Parameters
## - `conn`: Target `db` connection.
## - `model`: Target `ModelDef` (must declare a pk field).
## - `id`: Primary key value.
##
## ### Returns
## The row map, or null.
pub function find_by_id(conn, model: ModelDef, id)
    # Inline null guard (see model_param): let-binding a dynamic
    # null return demotes it to int 0 on current compilers.
    if pk_field(model) is null
        throw db::db_error(2, f"orm: model '{model.table}' has no primary key")
    end
    let pk = pk_field(model)
    let cond = map()
    cond[field_name(pk)] = id
    let rows = where(conn, model, cond)
    if len(rows) == 0
        return null
    end
    return rows[0]
end

## Counts rows matching `cond` (null `cond` counts all rows).
##
## ### Parameters
## - `conn`: Target `db` connection.
## - `model`: Target `ModelDef`.
## - `cond`: Filter map, or null.
##
## ### Returns
## Matching row count integer.
pub function count(conn, model: ModelDef, cond = null) -> int
    let parts = where_parts(model, cond)
    return db::query_scalar(conn, "SELECT count(*) FROM " + model.table + parts.sql + ";", parts.params)
end

# ───────────────────────────────────────────────────────────────
# ModelDef Struct Methods
# ───────────────────────────────────────────────────────────────

## Creates this model's table.
##
## ### Parameters
## - `self`: The target `ModelDef`.
## - `conn`: Target `db` connection.
##
## ### Returns
## Affected row count integer.
pub function ModelDef.create_table(self: ModelDef, conn) -> int
    return create_table(conn, self)
end

## Drops this model's table.
##
## ### Parameters
## - `self`: The target `ModelDef`.
## - `conn`: Target `db` connection.
##
## ### Returns
## Affected row count integer.
pub function ModelDef.drop_table(self: ModelDef, conn) -> int
    return drop_table(conn, self)
end

## Inserts one row into this model's table.
##
## ### Parameters
## - `self`: The target `ModelDef`.
## - `conn`: Target `db` connection.
## - `values`: Map of column name to value.
##
## ### Returns
## Affected row count integer.
pub function ModelDef.insert(self: ModelDef, conn, values) -> int
    return insert(conn, self, values)
end

## Updates rows of this model's table.
##
## ### Parameters
## - `self`: The target `ModelDef`.
## - `conn`: Target `db` connection.
## - `values`: Map of column name to new value.
## - `cond`: Filter map, or null for all rows.
##
## ### Returns
## Affected row count integer.
pub function ModelDef.update(self: ModelDef, conn, values, cond = null) -> int
    return update(conn, self, values, cond)
end

## Deletes rows of this model's table matching `cond`.
##
## ### Parameters
## - `self`: The target `ModelDef`.
## - `conn`: Target `db` connection.
## - `cond`: Filter map (must be non-empty).
##
## ### Returns
## Affected row count integer.
pub function ModelDef.delete_where(self: ModelDef, conn, cond) -> int
    return delete_where(conn, self, cond)
end

## Returns all rows of this model's table.
##
## ### Parameters
## - `self`: The target `ModelDef`.
## - `conn`: Target `db` connection.
##
## ### Returns
## Array of row maps (possibly empty).
pub function ModelDef.find_all(self: ModelDef, conn) -> array
    return find_all(conn, self)
end

## Returns rows of this model's table matching `cond`.
##
## ### Parameters
## - `self`: The target `ModelDef`.
## - `conn`: Target `db` connection.
## - `cond`: Filter map, or null.
##
## ### Returns
## Array of row maps (possibly empty).
pub function ModelDef.where(self: ModelDef, conn, cond = null) -> array
    return where(conn, self, cond)
end

## Counts rows of this model's table.
##
## ### Parameters
## - `self`: The target `ModelDef`.
## - `conn`: Target `db` connection.
## - `cond`: Filter map, or null.
##
## ### Returns
## Matching row count integer.
pub function ModelDef.count(self: ModelDef, conn, cond = null) -> int
    return count(conn, self, cond)
end
