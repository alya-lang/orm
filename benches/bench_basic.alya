## Benchmark suite for orm
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "db" as db
import "../src/lib.alya" as pkg

function bench_users_model()
    return pkg::define_model("users", [pkg::field("id", pkg::KIND_INT, 1), pkg::field("name", pkg::KIND_TEXT), pkg::field("score", pkg::KIND_FLOAT)])
end

function main()
    let runner = bench_runner("orm Micro-Benchmarks")
    let users = bench_users_model()

    # Bench 1: DDL generation (pure, no driver) — 50k iterations
    bench_start(runner, 50000)
    let i = 0
    while i < 50000
        pkg::create_table_sql(users)
        i += 1
    end
    bench_stop(runner, "create_table_sql 50k builds")

    # Bench 2: insert roundtrip on sqlite-backed db — 2k iterations
    let conn = db::open(db::sqlite_driver(), ":memory:")
    pkg::create_table(conn, users)
    bench_start(runner, 2000)
    let j = 0
    while j < 2000
        let row = map()
        row["id"] = j
        row["name"] = "Bench"
        row["score"] = "1.5"
        pkg::insert(conn, users, row)
        j += 1
    end
    bench_stop(runner, "insert 2k rows")

    # Bench 3: conditional queries — 2k iterations
    bench_start(runner, 2000)
    let k = 0
    while k < 2000
        pkg::where(conn, users, null, "id", "ASC", 10)
        k += 1
    end
    bench_stop(runner, "where with limit 2k queries")
    db::close(conn)

    bench_summary(runner)
end

main()
