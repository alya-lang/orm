## Benchmark suite for orm
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function bench_users_model()
    return pkg::define_model("users", [pkg::field("id", pkg::KIND_INT, 1), pkg::field("name", pkg::KIND_TEXT), pkg::field("score", pkg::KIND_FLOAT)])
end

function bench_row(i: int)
    let m = map()
    m["id"] = i
    m["name"] = "Bench"
    m["score"] = "1.5"
    return m
end

function bench_core(runner)
    # Bench 2: row-map construction (no driver) — 50k iterations.
    # DB writes stay in the test suite by design (correctness belongs
    # there); benchmarks measure pure build paths only.
    bench_start(runner, 50000)
    let j = 0
    while j < 50000
        bench_row(j)
        j += 1
    end
    bench_stop(runner, "row-map build 50k rows")
end

@cfg(feature = "schema")
function bench_schema(runner)
    let users = bench_users_model()
    # Bench 1: DDL generation (pure, no driver) — 50k iterations
    bench_start(runner, 50000)
    let i = 0
    while i < 50000
        pkg::create_table_sql(users)
        i += 1
    end
    bench_stop(runner, "create_table_sql 50k builds")
end

@cfg(not(feature = "schema"))
function bench_schema(runner)
end

function main()
    let runner = bench_runner("orm Micro-Benchmarks")

    bench_core(runner)
    bench_schema(runner)

    bench_summary(runner)
end

main()
