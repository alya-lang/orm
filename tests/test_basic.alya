## Test suite for orm
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "db" as db
import "../src/lib.alya" as pkg

function make_users_model()
    return pkg::define_model("users", [pkg::field("id", pkg::KIND_INT, 1), pkg::field("name", pkg::KIND_TEXT), pkg::field("score", pkg::KIND_FLOAT), pkg::field("payload", pkg::KIND_BLOB), pkg::field("note", pkg::KIND_TEXT)])
end

function make_counters_model()
    return pkg::define_model("counters", [pkg::field("val", pkg::KIND_INT)])
end

# Value maps are built via indexassign, never as mixed literals: a
# heterogeneous map literal demotes every value to one static type at
# check time, corrupting downstream typed boundaries. Indexassigned maps
# keep fully dynamic values (same rule as `sqlite` row decoding).
function user_row(id: int, name: string, score: string, payload, note)
    let m = map()
    m["id"] = id
    m["name"] = name
    m["score"] = score
    m["payload"] = payload
    m["note"] = note
    return m
end

function main()
    test_suite("orm Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Model definition & validation (pure, no driver)
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::KIND_INT, 1, "KIND_INT == 1")
    runner_assert_eq(r, pkg::KIND_FLOAT, 2, "KIND_FLOAT == 2")
    runner_assert_eq(r, pkg::KIND_TEXT, 3, "KIND_TEXT == 3")
    runner_assert_eq(r, pkg::KIND_BLOB, 5, "KIND_BLOB == 5")

    let users = make_users_model()
    runner_assert_str_eq(r, users.table, "users", "model table is users")
    runner_assert_eq(r, len(users.fields), 5, "model has 5 fields")
    runner_assert_true(r, pkg::find_field(users, "name") is not null, "find_field locates name")
    runner_assert_true(r, pkg::find_field(users, "nope") is null, "find_field misses unknown")
    runner_assert_str_eq(r, pkg::field_name(pkg::pk_field(users)), "id", "pk_field is id")
    runner_assert_true(r, pkg::pk_field(make_counters_model()) is null, "pkless model has no pk")

    let bad_kind = 0
    try
        pkg::field("x", 4)
    catch err
        bad_kind = err.code
    end
    runner_assert_eq(r, bad_kind, 2, "unknown field kind throws code 2")

    let bad_pk = 0
    try
        pkg::field("x", pkg::KIND_TEXT, 1)
    catch err
        bad_pk = err.code
    end
    runner_assert_eq(r, bad_pk, 2, "text pk throws code 2")

    let empty_model = 0
    try
        pkg::define_model("empty", [])
    catch err
        empty_model = err.code
    end
    runner_assert_eq(r, empty_model, 2, "empty model throws code 2")

    # ═══════════════════════════════════════════════════════════
    # 2. DDL generation (pure, no driver)
    # ═══════════════════════════════════════════════════════════
    runner_assert_str_eq(r, pkg::create_table_sql(users), "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, score REAL, payload BLOB, note TEXT);", "DDL renders fully")

    # ═══════════════════════════════════════════════════════════
    # 3. Real roundtrip over db + sqlite adapter (in-memory)
    # ═══════════════════════════════════════════════════════════
    let conn = db::open(db::sqlite_driver(), ":memory:")
    runner_assert_eq(r, pkg::create_table(conn, users), 0, "create_table succeeds")

    let big = 1099511627776
    let bigrow_in = map()
    bigrow_in["id"] = big
    bigrow_in["name"] = "O'Brien"
    bigrow_in["score"] = "19.99"
    bigrow_in["payload"] = [9, 8, 7]
    bigrow_in["note"] = null
    runner_assert_eq(r, pkg::insert(conn, users, bigrow_in), 1, "insert affects 1 row")

    let got = pkg::find_by_id(conn, users, big)
    runner_assert_true(r, got is not null, "find_by_id returns row")
    runner_assert_eq(r, got["id"], big, "int64 pk roundtrips")
    runner_assert_str_eq(r, got["name"], "O'Brien", "quoted text roundtrips")
    runner_assert_str_eq(r, str(got["score"]), "19.99", "float-as-text roundtrips")
    runner_assert_true(r, got["note"] is null, "null stays null")
    runner_assert_eq(r, len(got["payload"]), 3, "blob roundtrips")

    runner_assert_true(r, pkg::find_by_id(conn, users, 999999) is null, "find_by_id on missing returns null")

    runner_assert_eq(r, pkg::insert(conn, users, user_row(2, "Bob", "88.0", [], "x")), 1, "second insert succeeds")

    let all = pkg::find_all(conn, users, "id", "ASC")
    runner_assert_eq(r, len(all), 2, "find_all returns 2 rows")

    let lim = pkg::find_all(conn, users, "id", "ASC", 1)
    runner_assert_eq(r, len(lim), 1, "find_all honors limit")

    let w = pkg::where(conn, users, { "name": "Bob" })
    runner_assert_eq(r, len(w), 1, "where filters by text")

    runner_assert_eq(r, pkg::count(conn, users, null), 2, "count totals 2")
    runner_assert_eq(r, pkg::count(conn, users, { "name": "Bob" }), 1, "count filters")

    # ═══════════════════════════════════════════════════════════
    # 4. Update, delete, drop (verified by re-reads)
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::update(conn, users, { "name": "Bobby" }, { "id": 2 }), 1, "update affects 1 row")
    let upd = pkg::find_by_id(conn, users, 2)
    runner_assert_str_eq(r, upd["name"], "Bobby", "update persists")

    runner_assert_eq(r, pkg::delete_by_id(conn, users, 2), 1, "delete_by_id affects 1 row")
    runner_assert_true(r, pkg::find_by_id(conn, users, 2) is null, "deleted row is gone")
    runner_assert_eq(r, pkg::delete_where(conn, users, { "name": "O'Brien" }), 1, "delete_where affects 1 row")
    runner_assert_eq(r, pkg::count(conn, users, null), 0, "table is empty")

    let no_wipe = 0
    try
        pkg::delete_where(conn, users, null)
    catch err
        no_wipe = err.code
    end
    runner_assert_eq(r, no_wipe, 2, "unconditional delete throws code 2")

    let no_empty = 0
    try
        pkg::update(conn, users, map(), { "id": 1 })
    catch err
        no_empty = err.code
    end
    runner_assert_eq(r, no_empty, 2, "empty update throws code 2")

    # ═══════════════════════════════════════════════════════════
    # 5. Transactions (real rollback through db facade)
    # ═══════════════════════════════════════════════════════════
    db::begin(conn)
    pkg::insert(conn, users, user_row(3, "Carol", "70.0", [], null))
    db::rollback(conn)
    runner_assert_eq(r, pkg::count(conn, users, null), 0, "rollback undoes insert")
    db::begin(conn)
    pkg::insert(conn, users, user_row(3, "Carol", "70.0", [], null))
    db::commit(conn)
    runner_assert_eq(r, pkg::count(conn, users, null), 1, "commit persists insert")

    # ═══════════════════════════════════════════════════════════
    # 6. Engine errors arrive normalized as DbError
    # ═══════════════════════════════════════════════════════════
    let badcode = 0
    try
        db::execute(conn, "SELECT * FROM no_such_table;", [])
    catch err
        badcode = err.code
    end
    runner_assert_eq(r, badcode, 1, "engine error arrives as DbError code 1")

    # ═══════════════════════════════════════════════════════════
    # 7. Strictness: mistyped and missing values throw, never corrupt
    # ═══════════════════════════════════════════════════════════
    let miss_map = map()
    miss_map["id"] = 4
    miss_map["name"] = "Dan"
    let miss_val = 0
    try
        pkg::insert(conn, users, miss_map)
    catch err
        miss_val = err.code
    end
    runner_assert_eq(r, miss_val, 2, "missing value throws code 2")

    let wrong_map = map()
    wrong_map["id"] = "four"
    wrong_map["name"] = "Dan"
    wrong_map["score"] = "60.0"
    wrong_map["payload"] = []
    wrong_map["note"] = null
    let wrong_type = 0
    try
        pkg::insert(conn, users, wrong_map)
    catch err
        wrong_type = err.code
    end
    runner_assert_eq(r, wrong_type, 2, "text-for-int throws code 2")

    # NOTE: float dynamics cannot be routed (indistinguishable from ints
    # at runtime), so there is no throw to assert here: float columns take
    # round-trip text, covered by the "95.5" inserts above.

    let bad_cond = 0
    try
        pkg::where(conn, users, { "hacker": 1 })
    catch err
        bad_cond = err.code
    end
    runner_assert_eq(r, bad_cond, 2, "unknown cond column throws code 2")

    let bad_order = 0
    try
        pkg::where(conn, users, null, "hacker")
    catch err
        bad_order = err.code
    end
    runner_assert_eq(r, bad_order, 2, "hostile order column throws code 2")

    let bad_dir = 0
    try
        pkg::where(conn, users, null, "id", "SIDEWAYS")
    catch err
        bad_dir = err.code
    end
    runner_assert_eq(r, bad_dir, 2, "bad direction throws code 2")

    let no_pk = 0
    try
        pkg::find_by_id(conn, make_counters_model(), 1)
    catch err
        no_pk = err.code
    end
    runner_assert_eq(r, no_pk, 2, "find_by_id without pk throws code 2")

    # ═══════════════════════════════════════════════════════════
    # 8. ModelDef method forms
    # ═══════════════════════════════════════════════════════════
    # DDL returns the engine's stale change counter (SQLite does not reset
    # it for DDL), so these are effect-only calls proven by the ops below.
    users.drop_table(conn)
    users.create_table(conn)
    runner_assert_eq(r, users.insert(conn, user_row(5, "Erin", "55.5", [], null)), 1, "ModelDef.insert affects 1 row")
    runner_assert_eq(r, len(users.find_all(conn)), 1, "ModelDef.find_all returns 1 row")
    runner_assert_eq(r, users.count(conn, null), 1, "ModelDef.count returns 1")
    runner_assert_eq(r, users.update(conn, { "name": "Erin2" }, { "id": 5 }), 1, "ModelDef.update affects 1 row")
    runner_assert_eq(r, users.delete_where(conn, { "id": 5 }), 1, "ModelDef.delete_where affects 1 row")
    users.drop_table(conn)
    db::close(conn)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
