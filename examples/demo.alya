## Example usage and walkthrough for orm
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
##
## Models declare columns once; every operation builds parameterized SQL.
## Float columns take round-trip text, converted with str() at a proven
## site (see the score handling below).

import "db" as db
import "../src/lib.alya" as pkg

pub struct User
    id: int
    name: string
    score: string
    note
end

function main()
    say "==========================================="
    say "            ORM PACKAGE SHOWCASE           "
    say "==========================================="

    # 1. Define the model (kinds mirror db ParamKind values)
    let users = pkg::define_model("users", [pkg::field("id", pkg::KIND_INT, 1), pkg::field("name", pkg::KIND_TEXT), pkg::field("score", pkg::KIND_FLOAT), pkg::field("note", pkg::KIND_TEXT)])
    say "1. Model defined: users (id INTEGER PRIMARY KEY, name TEXT, score REAL, note TEXT)"
    say "   DDL: " + pkg::create_table_sql(users)

    # 2. Open through db + sqlite adapter, create the table
    let conn = db::open(db::sqlite_driver(), ":memory:")
    pkg::create_table(conn, users)
    say "2. Table created on :memory:"

    # 3. Insert rows (floats as round-trip text via str() at this proven site)
    let score_alice = 95.5
    let row_alice = map()
    row_alice["id"] = 1
    row_alice["name"] = "Alice"
    row_alice["score"] = str(score_alice)
    row_alice["note"] = null
    pkg::insert(conn, users, row_alice)
    let row_bob = map()
    row_bob["id"] = 2
    row_bob["name"] = "Bob"
    row_bob["score"] = str(88.0)
    row_bob["note"] = "second"
    pkg::insert(conn, users, row_bob)
    say "3. Inserted 2 rows"

    # 4. Read back and fill a struct explicitly (recommended pattern)
    let found = pkg::find_by_id(conn, users, 1)
    let alice = User { id: found["id"], name: found["name"], score: found["score"], note: found["note"] }
    say "4. Struct fill: #" + str(alice.id) + " " + alice.name + " -> " + alice.score

    # 5. Filtered query + count
    let bobs = pkg::where(conn, users, null, "id", "DESC", 1)
    say "5. Latest row id: " + str(bobs[0]["id"]) + " (total: " + str(pkg::count(conn, users, null)) + ")"

    # 6. Update, delete, transactions
    pkg::update(conn, users, row_bob, null)
    pkg::delete_by_id(conn, users, 2)
    say "6. After update+delete, total: " + str(pkg::count(conn, users, null))
    db::begin(conn)
    pkg::insert(conn, users, row_bob)
    db::rollback(conn)
    say "   After rollback, total: " + str(pkg::count(conn, users, null))

    # 7. Strictness: unknown columns never reach SQL
    try
        pkg::where(conn, users, { "hacker": 1 })
    catch err
        say "7. Hostile column rejected, code " + str(err.code)
    end

    users.drop_table_m(conn)
    db::close(conn)
    say "==========================================="
end

main()
